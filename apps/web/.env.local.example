# Copy to .env.local (gitignored) and set your own server.
#
# Prefer the Tailscale name over nyx.local: DHCP reassigns LAN addresses and
# mDNS caches go stale, while the tailnet name is stable and gives you HTTPS.
#
#   NYX_SERVER=https://nyx.<your-tailnet>.ts.net
#
# The LAN name also works when you are on the same network:
#   NYX_SERVER=http://nyx.local

NYX_SERVER=http://nyx.local

# Optional: send /api to a nyx-api running on this machine instead.
#   NYX_API=http://localhost:8000
