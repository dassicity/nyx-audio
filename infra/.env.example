# Copy to .env on the Pi and adjust. .env is gitignored; this file is not.
#
#   id -u && id -g     → the values for PUID / PGID

PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Where the library lives on the Pi. Keep it outside the repo.
MUSIC_DIR=/srv/music

# Application databases. Must exist and be owned by PUID:PGID before first run:
#   sudo mkdir -p /srv/nyx/navidrome && sudo chown -R "$USER:$USER" /srv/nyx
DATA_DIR=/srv/nyx
