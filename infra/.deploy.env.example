# Copy to .deploy.env (gitignored) — or just run ./deploy-web.sh, which asks
# for these on first run and writes the file for you.

# Hostname or ssh alias of the machine running Nyx.
#   NYX_HOST=nyx.local                  mDNS on the LAN
#   NYX_HOST=192.168.1.42               fixed address
#   NYX_HOST=nyx.<tailnet>.ts.net       stable across DHCP churn; TLS
NYX_HOST=nyx.local

# Login on that machine. Defaults to your local username.
NYX_USER=

# Where the built client is written. Must match WEB_DIR in .env, which is what
# compose.yml mounts into Caddy.
WEB_DIR=/srv/nyx/web

# Optional: an ssh key for unattended deploys.
SSH_KEY=
