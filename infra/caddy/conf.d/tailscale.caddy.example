# Generated by ../../setup-tailscale.sh — do not edit by hand, and do not
# commit the generated tailscale.caddy. {{FQDN}} is replaced with this
# machine's tailnet name.
https://{{FQDN}} {
	import common
	tls /certs/{{FQDN}}.crt /certs/{{FQDN}}.key

	# v1.5: SharedArrayBuffer for the Web Audio ring buffer needs these.
	# header {
	#	Cross-Origin-Opener-Policy   same-origin
	#	Cross-Origin-Embedder-Policy require-corp
	# }

	# Navidrome keeps its own UI at /app — useful for admin (users, scans,
	# transcoding settings). Its API and auth endpoints live alongside it.
	handle /rest/* {
		reverse_proxy navidrome:4533 {
			flush_interval -1
		}
	}
	handle /auth/* {
		reverse_proxy navidrome:4533
	}
	handle /app/* {
		reverse_proxy navidrome:4533
	}
	handle /share/* {
		reverse_proxy navidrome:4533
	}

	handle /api/* {
		reverse_proxy nyx-api:8000
	}

	# Everything else is the Nyx client: a static SPA built on the laptop and
	# rsynced here. try_files sends unknown paths to index.html so client-side
	# routes survive a refresh.
	handle {
		root * /srv/nyx-web
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}
}
