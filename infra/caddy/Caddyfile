# Nyx Audio — Caddy
#
# One origin for everything: the client, the Subsonic API and the audio stream
# all come from the same host, so there is no CORS and no mixed-content problem.
#
# Routing (docs/tech-stack.md, D9):
#   /rest/*  → navidrome   Subsonic / OpenSubsonic API and audio bytes
#   /api/*   → nyx-api     play history, stats, crate, enrichment  (v1)
#   /        → nyx-web     the built client                        (v1)
#
# Until nyx-web exists, / falls through to Navidrome's own UI — which is what
# you use to confirm the first scan found everything.

{
	admin off
	# Uncomment while debugging a route:
	# debug
}

(common) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# ── LAN over plain HTTP ──────────────────────────────────────────────────
# Correct for a first deploy on a trusted home network. It is NOT enough for
# v3: installable apps and offline caching need a secure context, which is
# what the Tailscale block below is for.
# `:80` answers on ANY hostname — nyx.local, nil.local, the bare IP, whatever
# the Pi is called this week. Host matching buys nothing with one site on a
# trusted LAN, and a hostname mismatch otherwise 404s with no obvious cause.
:80 {
	import common

	# Navidrome keeps its own UI at /app — useful for admin (users, scans,
	# transcoding settings). Its API and auth endpoints live alongside it.
	handle /rest/* {
		reverse_proxy navidrome:4533 {
			flush_interval -1
		}
	}
	handle /auth/* {
		reverse_proxy navidrome:4533
	}
	handle /app/* {
		reverse_proxy navidrome:4533
	}
	handle /share/* {
		reverse_proxy navidrome:4533
	}

	# (v1) handle /api/* {
	#	reverse_proxy nyx-api:8000
	# }

	# Everything else is the Nyx client: a static SPA built on the laptop and
	# rsynced here. try_files sends unknown paths to index.html so client-side
	# routes survive a refresh.
	handle {
		root * /srv/nyx-web
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}
}

# ── Tailscale HTTPS ──────────────────────────────────────────────────────
# Generated per-machine by ./setup-tailscale.sh, which writes
# caddy/conf.d/tailscale.caddy with that host's own tailnet name. That file is
# gitignored — a tailnet name identifies your network and does not belong in a
# public repo.
#
# A glob that matches nothing is not an error in Caddy, so a machine without
# Tailscale simply serves HTTP from the :80 block above and carries on.
import /etc/caddy/conf.d/*.caddy
