# ── Music library: NEVER in git ──────────────────────────────
# 10+ GB of audio will destroy this repo. Keep the library on disk,
# back it up with restic, and keep git for code only.
ss music/
music/
*.flac
*.mp3
*.wav
*.m4a
*.aiff
*.ape

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
desktop.ini
Thumbs.db
AlbumArt*.jpg
AlbumArtSmall.jpg

# ── Toolchain ────────────────────────────────────────────────
node_modules/
dist/
.vite/
__pycache__/
*.pyc
.venv/
.env
.env.*
!.env.example
!.env.local.example

nyx-staging/
docs/
design_handoff_nyx_audio/

# ── TLS material: never in git ───────────────────────────────
infra/caddy/certs/
infra/caddy/conf.d/*.caddy
!infra/caddy/conf.d/*.caddy.example
*.key
*.crt
*.pem
